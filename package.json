{
    "name": "@daanvandenbergh/i18nkit",
    "version": "1.0.2",
    "description": "Type-safe i18n for TypeScript - miss a translation and it's a compile error. Framework-agnostic core, optional React layer, and a Claude Code skill that sweeps for untranslated strings.",
    "type": "module",
    "author": "Daan van den Bergh",
    "keywords": [
        "i18n",
        "internationalization",
        "localization",
        "typescript",
        "type-safe",
        "react",
        "translations"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/daanvandenbergh/i18nkit.git"
    },
    "homepage": "https://github.com/daanvandenbergh/i18nkit#readme",
    "bugs": {
        "url": "https://github.com/daanvandenbergh/i18nkit/issues"
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "sideEffects": [
        "**/*.css"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./react": {
            "types": "./dist/react/index.d.ts",
            "default": "./dist/react/index.js"
        },
        "./styles.css": "./dist/react/styles.css",
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "skills"
    ],
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json && cp src/react/styles.css dist/react/styles.css",
        "test": "vitest run --passWithNoTests",
        "test:watch": "vitest",
        "typecheck": "tsc --noEmit",
        "prepublishOnly": "npm run build",
        "push-and-publish": "git add -A && git commit -m 'Updates' && npm version patch && npm publish && git push -u origin main"
    },
    "peerDependencies": {
        "react": ">=18",
        "react-dom": ">=18"
    },
    "peerDependenciesMeta": {
        "react": {
            "optional": true
        },
        "react-dom": {
            "optional": true
        }
    },
    "devDependencies": {
        "@daanvandenbergh/claudekit": "^1.0.6",
        "@daanvandenbergh/scribekit": "^1.7.2",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "@vitest/coverage-v8": "^3.2.7",
        "jsdom": "^25",
        "react": "^19",
        "react-dom": "^19",
        "typescript": "^5.6.0",
        "vitest": "^3.0.0"
    }
}
